# Optional host-access overrides for docker-compose.host-access.yml
# Copy to .env.host-access.local, customize ports, then:
#   set -a; . ./.env.host-access.local; set +a
#   ./scripts/start.sh --host-access

HOST_API_BIND=127.0.0.1
HOST_API_PORT=8000

HOST_OLLAMA_BIND=127.0.0.1
HOST_OLLAMA_PORT=11434

HOST_POSTGRES_BIND=127.0.0.1
HOST_POSTGRES_PORT=5432

HOST_REDIS_BIND=127.0.0.1
HOST_REDIS_PORT=6379
